# ── Lovable Cloud (já provisionado no projeto — copiado de .env real) ────────
# Estas variáveis são injetadas automaticamente no preview/publish.
# Para desenvolvimento local, copie este arquivo para .env e preencha.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
VITE_SUPABASE_PROJECT_ID=seu-project-id

# ── Servidor (somente server functions / edge — NUNCA prefixar com VITE_) ────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
# SUPABASE_SERVICE_ROLE_KEY=indisponível no Lovable Cloud (não solicitar)

# ── Integrações opcionais (dev local: scripts pulam com aviso se ausentes) ───
# INDEXNOW_KEY=chave-indexnow
# GOOGLE_SEARCH_CONSOLE_API_KEY=via gateway Lovable
